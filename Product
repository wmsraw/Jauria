/* Mobile Menu */
function initMobileMenu() {
  const mobileToggle = document.querySelector('.mobile-menu-toggle');
  const headerNav = document.querySelector('.site-header nav');
  const mobileMenu = document.querySelector('.mobile-menu');

  if (!mobileToggle || !headerNav || !mobileMenu) return;

  mobileToggle.addEventListener('click', function() {
    const isNavOpen = headerNav.classList.toggle('open');
    const isMenuOpen = mobileMenu.classList.toggle('open');
    mobileToggle.setAttribute('aria-expanded', isMenuOpen);
    mobileToggle.setAttribute('aria-label', isMenuOpen ? 'Cerrar menú' : 'Abrir menú');
  });

  // Close menu when clicking a link
  const navLinks = document.querySelectorAll('.site-header nav a, .mobile-menu nav a');
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (headerNav.classList.contains('open') || mobileMenu.classList.contains('open')) {
        headerNav.classList.remove('open');
        mobileMenu.classList.remove('open');
        mobileToggle.setAttribute('aria-expanded', false);
        mobileToggle.setAttribute('aria-label', 'Abrir menú');
      }
    });
  });

  // Close menu when clicking outside
  document.addEventListener('click', function(e) {
    const header = document.querySelector('header');
    const isClickInside = header.contains(e.target);
    const isMenuOpen = headerNav.classList.contains('open') || mobileMenu.classList.contains('open');

    if (!isClickInside && isMenuOpen) {
      headerNav.classList.remove('open');
      mobileMenu.classList.remove('open');
      mobileToggle.setAttribute('aria-expanded', false);
      mobileToggle.setAttribute('aria-label', 'Abrir menú');
    }
  });
}

/* Header Scroll Effects */
function initHeaderScroll() {
  const header = document.querySelector('header');
  if (!header) return;

  let lastScrollY = window.pageYOffset;

  window.addEventListener('scroll', function() {
    const scrollY = window.pageYOffset;

    if (scrollY > 50) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }

    lastScrollY = scrollY;
  });
}

/* Lazy Loading for Images */
function initLazyLoading() {
  if ('loading' in HTMLImageElement.prototype) {
    // Browser supports native lazy loading
    return;
  }

  const lazyImages = document.querySelectorAll('img[loading="lazy"]');

  if (lazyImages.length === 0) return;

  const lazyLoadObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const img = entry.target;
        img.src = img.dataset.src;
        img.removeAttribute('data-src');
        observer.unobserve(img);
      }
    });
  });

  lazyImages.forEach(img => {
    lazyLoadObserver.observe(img);
  });
}

/* Smooth Scroll for Anchor Links */
function initSmoothScroll() {
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const target = document.querySelector(this.getAttribute('href'));

      if (target) {
        e.preventDefault();

        const headerHeight = document.querySelector('header') ?
          document.querySelector('header').offsetHeight : 0;

        const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - headerHeight;

        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });
      }
    });
  });
}

/* Cart Functionality */
function initCart() {
  // Update cart count from localStorage (simulated)
  updateCartCount();

  // Listen for cart updates
  document.addEventListener('cartUpdated', updateCartCount);
}

function updateCartCount() {
  const cartCount = document.querySelector('.header .cart-icon .count');
  if (cartCount) {
    // In a real implementation, this would read from localStorage or cookies
    // For demo, we'll simulate with a random number
    const count = Math.floor(Math.random() * 10);
    cartCount.textContent = count;
    // Hide cart count if zero
    cartCount.parentElement.style.display = count > 0 ? 'flex' : 'none';
  }
}

/* Announcement Bar Dismiss */
function initAnnouncementBar() {
  const announcementBar = document.querySelector('.header-top-bar');
  if (!announcementBar) return;

  // Check if user has dismissed it before
  if (localStorage.getItem('announcementDismissed') === 'true') {
    announcementBar.style.display = 'none';
    return;
  }

  // Add close button if not present
  if (!announcementBar.querySelector('.announcement-close')) {
    const closeBtn = document.createElement('button');
    closeBtn.className = 'announcement-close';
    closeBtn.innerHTML = '&times;';
    closeBtn.setAttribute('aria-label', 'Cerrar anuncio');
    closeBtn.style.cssText = `
      position: absolute;
      top: 50%;
      right: 1rem;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      font-size: 1.8rem;
      color: inherit;
      cursor: pointer;
      padding: 0;
      line-height: 1;
    `;
    announcementBar.style.position = 'relative';
    announcementBar.appendChild(closeBtn);

    closeBtn.addEventListener('click', function() {
      announcementBar.style.display = 'none';
      localStorage.setItem('announcementDismissed', 'true');
    });
  }
}

/* Testimonials Carousel */
function initTestimonialsCarousel() {
  const slides = document.querySelectorAll('.testimonial-slide');
  const navButtons = document.querySelectorAll('.carousel-nav button');
  let currentIndex = 0;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      slide.classList.toggle('active', i === index);
    });
    navButtons.forEach((button, i) => {
      button.classList.toggle('active', i === index);
    });
    currentIndex = index;
  }

  navButtons.forEach((button, index) => {
    button.addEventListener('click', function() {
      showSlide(index);
    });
  });

  // Auto-advance every 5 seconds
  let autoAdvance = setInterval(() => {
    const nextIndex = (currentIndex + 1) % slides.length;
    showSlide(nextIndex);
  }, 5000);

  // Pause on hover
  const carousel = document.querySelector('.testimonials-carousel');
  carousel.addEventListener('mouseenter', function() {
