    document.head.appendChild(script);
  }

  // Initialize ads when script loads or when called manually
  function initializeAds() {
    // Only proceed if adsbygoogle is available
    if (typeof window.adsbygoogle === 'undefined') {
      // Wait for script to load
      return loadAdSenseScript();
    }

    // Initialize all adsbygoogle elements
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  }

  // Load script on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadAdSenseScript);
  } else {
    loadAdSenseScript();
  }

  // Expose functions for manual initialization (e.g., after AJAX content load)
