/*
  Main Styles - Jauria Viral HTML Site
*/

/* CSS Variables for easy theming */
:root {
  --color-primary: #ff6b6b;
  --color-secondary: #4ecdc4;
  --color-dark: #2c3e50;
  --color-light: #ffffff;
  --color-muted: #7f8c8d;
  --color-border: #eee;
  --color-bg-light: #fafafa;

  --font-primary: 'Montserrat', sans-serif;
  --font-body: 'Open Sans', sans-serif;

  --transition-base: 0.3s ease;
  --transition-fast: 0.15s ease;
  --transition-slow: 0.5s ease;

  --border-radius: 12px;
  --border-radius-pill: 50px;
  --box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  --box-shadow-hover: 0 12px 20px rgba(0,0,0,0.1);
}

/* Global Reset and Base Styles */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-size: 62.5%; /* 1rem = 10px */
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  font-size: 1.6rem;
  line-height: 1.6;
  color: var(--color-dark);
  background-color: var(--color-background);
  margin: 0;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-primary);
  font-weight: 600;
  line-height: 1.3;
  margin-top: 0;
  margin-bottom: 1.5rem;
}

h1 { font-size: 3.2rem; }
h2 { font-size: 2.6rem; }
h3 { font-size: 2.2rem; }
h4 { font-size: 1.8rem; }
h5 { font-size: 1.6rem; }
h6 { font-size: 1.4rem; }

p {
  margin-top: 0;
  margin-bottom: 1.5rem;
}

a {
  color: var(--color-primary);
  text-decoration: none;
  transition: var(--transition-base);
}

a:hover {
  color: var(--color-secondary);
  text-decoration: underline;
}

/* Utility Classes */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-left { text-align: left; }

.mt-0 { margin-top: 0; }
.mt-5 { margin-top: .5rem; }
.mt-10 { margin-top: 1rem; }
.mt-15 { margin-top: 1.5rem; }
.mt-20 { margin-top: 2rem; }
.mt-25 { margin-top: 2.5rem; }
.mt-30 { margin-top: 3rem; }

.mb-0 { margin-bottom: 0; }
.mb-5 { margin-bottom: .5rem; }
.mb-10 { margin-bottom: 1rem; }
.mb-15 { margin-bottom: 1.5rem; }
.mb-20 { margin-bottom: 2rem; }
.mb-25 { margin-bottom: 2.5rem; }
.mb-30 { margin-bottom: 3rem; }

.container {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
}

/* Button Styles */
.btn {
  display: inline-block;
  font-family: var(--font-primary);
  font-weight: 600;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  border: none;
  transition: var(--transition-base);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
  color: var(--color-light);
  padding: 1.2rem 2.5rem;
  border-radius: var(--border-radius-pill);
  font-size: 1.6rem;
  box-shadow: 0 4px 10px rgba(255, 107, 107, 0.3);
}

.btn-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 15px rgba(255, 107, 107, 0.4);
}

.btn-secondary {
  background: transparent;
  color: var(--color-primary);
  border: 2px solid var(--color-primary);
  padding: 1.1rem 2.4rem;
  border-radius: var(--border-radius-pill);
  font-size: 1.6rem;
}

.btn-secondary:hover {
  background: rgba(255, 107, 107, 0.1);
  transform: translateY(-3px);
}

/* Image Styles */
img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Form Styles */
input,
select,
textarea {
  font-family: var(--font-body);
  font-size: 1.6rem;
  padding: 1.2rem;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  transition: var(--transition-base);
  width: 100%;
  max-width: 100%;
}

input:focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.2);
}

/* Layout Components */
.header-top-bar {
  background-color: var(--color-dark);
  color: var(--color-light);
  text-align: center;
  padding: .8rem 0;
  font-size: 1.4rem;
}

.header-top-bar a {
  color: var(--color-primary);
  text-decoration: none;
}

.header-top-bar a:hover {
  text-decoration: underline;
}

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 0;
  border-bottom: 1px solid var(--color-border);
  position: relative;
  z-index: 1000;
  background-color: var(--color-light);
}

.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.site-header .logo {
  display: flex;
  align-items: center;
}

.site-header .logo img {
  max-height: 4rem;
}

.site-header nav {
  display: flex;
  gap: 2.5rem;
}

.site-header nav a {
  color: var(--color-dark);
  text-decoration: none;
  font-weight: 500;
  padding: .5rem 0;
  position: relative;
  font-size: 1.6rem;
}

.site-header nav a:hover {
  color: var(--color-primary);
}

.site-header nav a::after {
  content: '';
  position: absolute;
  bottom: -.5rem;
  left: 0;
  width: 0;
  height: .2rem;
  background-color: var(--color-primary);
  transition: width var(--transition-base);
}

.site-header nav a:hover::after {
  width: 100%;
}

/* Mobile Menu Styles */
.mobile-menu-toggle {
  display: none;
  flex-direction: column;
  gap: .4rem;
  cursor: pointer;
}

.mobile-menu-toggle span {
  width: 2.5rem;
  height: .2rem;
  background-color: var(--color-dark);
  display: block;
  transition: var(--transition-base);
}

@media (max-width: 768px) {
  .mobile-menu-toggle {
    display: flex;
  }

  .site-header nav {
    position: fixed;
    top: 0;
    right: -100%;
    height: 100vh;
    width: 25rem;
    background-color: var(--color-light);
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0;
    padding: 8rem 2rem;
    transition: right var(--transition-slow);
    z-index: 999;
    border-left: 1px solid var(--color-border);
  }

  .site-header nav.open {
    right: 0;
  }

  .site-header nav a {
    padding: 1.2rem 0;
    width: 100%;
    border-bottom: 1px solid var(--color-border-light);
  }

  .site-header .cart-icon {
    margin-left: auto;
  }
}

/* Cart Icon */
.site-header .cart-icon {
  position: relative;
  display: flex;
  align-items: center;
}

.site-header .cart-icon a {
  color: var(--color-dark);
  text-decoration: none;
  font-size: 2.4rem;
}

.site-header .cart-icon .count {
  position: absolute;
  top: -.8rem;
  right: -.8rem;
  background-color: var(--color-primary);
  color: var(--color-light);
  border-radius: 50%;
  padding: .2rem .6rem;
  font-size: 1.2rem;
}

/* Mobile Menu Panel */
.mobile-menu {
  position: fixed;
  top: 0;
  right: -100%;
  height: 100vh;
  width: 25rem;
  background-color: var(--color-light);
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 0;
  padding: 8rem 2rem;
  transition: right var(--transition-slow);
  z-index: 999;
  border-left: 1px solid var(--color-border);
  display: flex;
}

.mobile-menu.open {
  right: 0;
}

.mobile-menu nav {
  display: flex;
  flex-direction: column;
  gap: 0;
  width: 100%;
}

.mobile-menu nav a {
  padding: 1.2rem 0;
  width: 100%;
  border-bottom: 1px solid var(--color-border-light);
}

/* Section Spacing */
.section-padding {
  padding: 6rem 0;
}

/* Overlay Styles */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.3);
}

/* Animation Utilities */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fade-in {
  animation: fadeIn .5s ease forwards;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.pulse {
  animation: pulse 2s infinite;
}

/* Accessibility */
.skip-to-content {
  position: absolute;
  left: -999px;
  top: auto;
  width: 1px;
  height: 1px;
  overflow: hidden;
}

.skip-to-content:focus {
  left: 1rem;
  top: 1rem;
  width: auto;
  height: auto;
  background: var(--color-primary);
  color: var(--color-light);
  padding: .8rem 1.2rem;
  border-radius: .4rem;
  z-index: 9999;
}

/* Print Styles */
@media print {
  body {
    font-size: 12pt;
    color: #000;
    background: #fff;
  }

  a {
    color: #000;
    text-decoration: underline;
  }

  .no-print,
  .header,
  .footer,
  .navigation,
  .sidebar,
  .ads,
  .social-sharing,
  .comment-form {
    display: none !important;
  }
}

/* Hero Banner Styles */
.hero-banner {
