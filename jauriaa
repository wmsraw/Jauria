    <!-- JavaScript for mobile menu, FAQ, and countdown -->
    <script>
        // Countdown honesto: EDITA esta fecha para que coincida con el fin real de tu promoción.
        // Por defecto: 7 días desde que se carga la página (rotativo, para no mentir con una fecha fija vieja).
        const promoEndDate = new Date();
        promoEndDate.setDate(promoEndDate.getDate() + 7);

        function updateCountdown() {
            const ahora = new Date().getTime();
            const distancia = promoEndDate.getTime() - ahora;
            const el = document.getElementById('countdown');
            if (!el) return;
            if (distancia < 0) {
                el.textContent = "¡Oferta finalizada!";
                return;
            }
            const horas = Math.floor((distancia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutos = Math.floor((distancia % (1000 * 60 * 60)) / (1000 * 60));
            const segundos = Math.floor((distancia % (1000 * 60)) / 1000);
            el.textContent = `${horas.toString().padStart(2, '0')}:${minutos.toString().padStart(2, '0')}:${segundos.toString().padStart(2, '0')}`;
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();

        // Mobile menu toggle
        document.getElementById('mobile-menu-btn').addEventListener('click', function() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        });

        // FAQ accordion
        document.querySelectorAll('.faq-question').forEach(item => {
            item.addEventListener('click', () => {
                const parent = item.parentElement;
                parent.classList.toggle('active');

                // Rotate icon
                const icon = parent.querySelector('svg');
                icon.classList.toggle('rotate-180');
            });
        });
    </script>
